{
  "name": "dailystories-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "concurrently \"npm run watch --workspace=@dailystories/shared\" \"npm run dev --workspace=@dailystories/backend\"",
    "start:frontend": "concurrently \"npm run watch --workspace=@dailystories/shared\" \"npm run dev --workspace=@dailystories/frontend\"",
    "start:backend": "concurrently \"npm run watch --workspace=@dailystories/shared\" \"npm run dev --workspace=@dailystories/backend\"",
    "setup": "npm run build --workspace=@dailystories/shared"
  },
  "devDependencies": {
    "concurrently": "^8.0.1"
  },
  "dependencies": {
    "eventsource": "^3.0.2"
  }
}
